[Unit]
Description=Chatbot ICT - Bot Telegram
After=network.target chatbot-ict-api.service
Wants=chatbot-ict-api.service

[Service]
Type=simple
User=maxi
WorkingDirectory=/home/maxi/chatbot-ict
ExecStart=/home/maxi/chatbot-ict/venv/bin/python src/bot/telegram_bot.py
Restart=always
RestartSec=15
Environment=PYTHONPATH=/home/maxi/chatbot-ict

[Install]
WantedBy=multi-user.target
