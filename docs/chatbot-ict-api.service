[Unit]
Description=Chatbot ICT - API FastAPI
After=network.target

[Service]
Type=simple
User=maxi
WorkingDirectory=/home/maxi/chatbot-ict
ExecStart=/home/maxi/chatbot-ict/venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
Environment=PYTHONPATH=/home/maxi/chatbot-ict

[Install]
WantedBy=multi-user.target
